# =============================================================================
# Rise & Shine HRM — environment variable reference
# Copy to `.env.development` (dev Supabase) or `.env` / `.env.local` as needed.
# NEVER commit filled-in files. All `.env*` except this example are git-ignored.
# =============================================================================

# --- Database (required) ---
# Pooled connection used by the Next.js app / Prisma Client at runtime.
DATABASE_URL=
# Session-mode / direct Postgres (port 5432). Required for `prisma db push` and psql RLS apply.
DIRECT_URL=
# Must match the PHI-safe dev project ref. Seed/reset scripts abort if DATABASE_URL lacks this.
DEV_SUPABASE_REF=gqfnqsxwoyrjphgcrzga
# Optional override used only by scripts/clone-schema-to-dev.sh (structure dump). Never put prod URLs in .env.development.
# PROD_DIRECT_URL=

# --- Supabase API (storage / admin helpers) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Prefer SUPABASE_SERVICE_ROLE_KEY; some older paths also read SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- App URLs / env labeling ---
# Public site origin for magic links and emails (use http://localhost:3000 for local).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Optional label for UI (e.g. development).
NEXT_PUBLIC_APP_ENV=development
NODE_ENV=development

# --- Prisma pooler tuning (Supabase session pooler) ---
# PRISMA_CONNECTION_LIMIT=8

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# --- Twilio SMS OTP (optional in local/dev if using ADMIN_FALLBACK_EMAIL) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Auth / access allowlists (comma-separated emails) ---
# Local OTP bypass when send/store fails — use @example.com seed users only on dev.
ADMIN_FALLBACK_EMAIL=admin@example.com
ADMIN_EMAIL=
SUPER_ADMIN_EMAILS=admin@example.com
LIMITED_ADMIN_EMAILS=
EXECUTIVE_ADMIN_EMAILS=
BILLING_MANAGER_EMAILS=admin@example.com
BILLING_PORTAL_EMAILS=
OPERATIONS_ACCESS_EMAILS=
SCHEDULE_ACCESS_EMAILS=
CLIENT_SERVICES_FULL_ACCESS_EMAILS=admin@example.com,bcba@example.com
# Step-up access code for Client Services (PHI). Dev default only — never commit real secrets.
CLIENT_SERVICES_ACCESS_CODE=20262027

# --- Crons / jobs ---
# Required for CRM cron routes (alerts/digest). Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Off by default. Set true only when Vercel crons should send mail.
AUTOMATIC_EMAILS_ENABLED=false
INTERVIEW_REMINDER_RECIPIENTS=admin@example.com
INTERVIEW_REMINDER_MINUTES=15

# --- Client Services CRM (parent emails) ---
# Kill-switch: must be explicitly true to send. Dev/staging stay false.
CRM_EMAILS_ENABLED=false
# Non-prod redirect target when CRM_EMAILS_ENABLED=true (never hits parent inboxes).
CRM_EMAIL_TEST_INBOX=

# --- Integrations / secrets ---
MOBILE_SYNC_SECRET=
HRM_WEBHOOK_SECRET=
MCP_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Test / script-only (never needed in production) ---
BILLING_TEST_EMAIL=
BILLING_TEST_NAME=
ARTEMIS_OPS_EXPORT=
DRY_RUN=

# --- Documented in setup guides (legacy NextAuth; app uses custom OTP today) ---
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
